# Default automatic text detection
* text=auto

# Python source
*.py text eol=lf

# Configuration and documentation
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.csv text eol=lf

# Shell scripts
*.sh text eol=lf
*.bash text eol=lf

# Windows scripts
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.npz binary
*.npy binary
*.pt binary
*.pth binary
*.ckpt binary
*.obj binary
*.stl binary
